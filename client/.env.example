# Copy to .env.local for local overrides. All VITE_ variables are PUBLIC
# (bundled into the website) — never put secrets here.

# URL of the deployed API (server/). Leave empty in development: Vite proxies
# /api to http://localhost:4000. If empty in a production build, the forms show
# "not switched on yet" and direct visitors to call instead.
VITE_API_URL=

# Public address of the website, no trailing slash. Enables canonical URLs,
# absolute Open Graph image URLs and sitemap.xml.
VITE_SITE_URL=
