# Copy this file to .env for local development. Never commit real secrets.

NODE_ENV=development
PORT=4000

# Front-end origins allowed to call the API (comma-separated, no trailing slash).
# Production example: https://your-hospital.vercel.app,https://www.yourhospital.ug
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Used in the optional acknowledgement email sent to patients.
HOSPITAL_NAME=[Hospital Name]

# ---- Storage ----
# Recommended for production: a free MongoDB Atlas cluster.
MONGODB_URI=
MONGODB_DB=hospital_website
# Without MONGODB_URI, development uses server/data/requests.json.
# In production, file storage is disabled unless you set ALLOW_FILE_STORAGE=true
# (only do that on a host with a persistent disk).
ALLOW_FILE_STORAGE=

# ---- Staff access ----
# Long random secret (at least 24 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# ---- Email notifications (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hospital Website <no-reply@example.com>"
NOTIFY_EMAIL=
# Also email the patient a "request received — not yet confirmed" note.
SEND_PATIENT_ACK=false

# ---- Abuse protection ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
MIN_FORM_FILL_MS=3000
# Number of proxies in front of the app (Render/Railway: 1).
TRUST_PROXY=
